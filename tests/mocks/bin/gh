#!/bin/bash
# Minimal gh mock for tests.
case "$1" in
  auth)
    [ -n "$MOCK_UNAUTH" ] && exit 1
    exit 0
    ;;
  repo)
    # repo list <org> --json ...
    case "$3" in
      testorg)
        cat <<'JSON'
[{"nameWithOwner":"testorg/alpha","name":"alpha","description":"First repo","isPrivate":false,"pushedAt":"2024-03-01T00:00:00Z","url":"https://github.com/testorg/alpha","owner":{"login":"testorg"}},{"nameWithOwner":"testorg/beta","name":"beta","description":"","isPrivate":true,"pushedAt":"2024-01-01T00:00:00Z","url":"https://github.com/testorg/beta","owner":{"login":"testorg"}}]
JSON
        ;;
      *)
        printf '[]'
        ;;
    esac
    ;;
  api)
    # api <path>
    case "$2" in
      *"/issues"*)
        cat <<'JSON'
[{"number":1,"title":"First issue"},{"number":2,"title":"Fix things","pull_request":{"url":"x"}}]
JSON
        ;;
      *"/branches"*)
        cat <<'JSON'
[{"name":"main"},{"name":"develop"}]
JSON
        ;;
      *"/commits"*)
        cat <<'JSON'
[{"sha":"abc1234def5678","commit":{"message":"first commit\n\ndetails"}},{"sha":"beef567890abcd","commit":{"message":"second commit"}}]
JSON
        ;;
      *)
        printf '[]'
        ;;
    esac
    ;;
  *)
    exit 0
    ;;
esac
